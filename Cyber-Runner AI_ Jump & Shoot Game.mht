<!DOCTYPE html><html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-81871a4c-2e9d-4a1a-bc69-5f8358d68eac@mhtml.blink" />
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cyber-Runner AI: Jump &amp; Shoot Game</title>
    <meta name="author" content="Vishal Kalansooriya">
    
</head>
<body>

    <header>
        <span class="badge">Open Source AI Vision • MediaPipe</span>
        <h1>CYBER-RUNNER: JUMP &amp; SHOOT</h1>
        <div class="controls-bar">
            <div class="control-pill">🖐️ <b>Show Hand in Camera:</b> Jump (Avoid Pits &amp; Ground Bots)</div>
            <div class="control-pill">😮 <b>Open Mouth:</b> Shoot Laser (Destroy Enemies)</div>
            <div class="control-pill">🦅 <b>High Flying Birds:</b> Stay on Ground (Don't Jump!)</div>
        </div>
    </header>

    <div class="main-layout">
        <!-- 2D Game Canvas Area -->
        <div class="game-wrapper">
            <div class="hud">
                <div class="hud-stats">
                    <span>SCORE: <span id="scoreVal" class="stat-val">0</span></span>
                    <span>BEST: <span id="bestVal" class="best-val">0</span></span>
                </div>
                <div class="gesture-indicators">
                    <div id="indJump" class="ind-badge">🖐️ HAND: OFF</div>
                    <div id="indShoot" class="ind-badge">😮 MOUTH: CLOSED</div>
                </div>
            </div>

            <canvas id="gameCanvas" width="720" height="380"></canvas>

            <div id="overlay">
                <h2 id="overlayTitle">Initializing Open-Source AI...</h2>
                <p id="overlaySub">Loading Hand &amp; Face Landmark models in your browser. Please allow camera access.</p>
                
                <div class="legend-grid">
                    <div class="legend-card">
                        <strong style="color:#ff3366;">🔥 Empty Hell Pits</strong>
                        Jump over them by showing your hand!
                    </div>
                    <div class="legend-card">
                        <strong style="color:#ffb700;">🤖 Ground Walkers</strong>
                        Open mouth to shoot OR jump over them!
                    </div>
                    <div class="legend-card">
                        <strong style="color:#00f3ff;">🦅 Sky Swoopers</strong>
                        Fly at jump-height. Stay low (Don't jump) or shoot!
                    </div>
                </div>

                <button id="startBtn" class="btn-start" disabled="">Loading AI Models...</button>
            </div>
        </div>

        <!-- Webcam AI Debugger -->
        <div class="cam-wrapper">
            <div>
                <div class="cam-header">
                    <span>AI VISION FEED (HAND + FACE)</span>
                    <span class="fps-tag" id="fpsTag">60 FPS</span>
                </div>
                <div class="cam-box">
                    <video id="webcam" autoplay="" playsinline="" muted=""></video>
                    <canvas id="camCanvas" width="320" height="240"></canvas>
                </div>
            </div>

            <div class="meter-box">
                <div class="meter-row">
                    <span>Mouth Openness:</span>
                    <div class="meter-bar-bg">
                        <div id="mouthBar" class="meter-bar-fill"></div>
                    </div>
                </div>
            </div>

            <div id="aiStatus" class="cam-status">Loading Hand &amp; Face AI Models...</div>
        </div>
    </div>

    


</body></html>
