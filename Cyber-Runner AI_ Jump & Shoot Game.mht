@charset "utf-8";

:root { --bg-dark: #090d16; --panel-bg: #111827; --border-clr: #1f2937; --neon-blue: #00f3ff; --neon-pink: #ff007f; --neon-green: #00ff66; --neon-amber: #ffb700; }

* { box-sizing: border-box; margin: 0px; padding: 0px; user-select: none; }

body { background-color: var(--bg-dark); background-image: radial-gradient(circle at 50% 0%, rgba(0, 243, 255, 0.12) 0%, transparent 50%), radial-gradient(circle at 80% 80%, rgba(255, 0, 127, 0.08) 0%, transparent 40%); color: rgb(248, 250, 252); font-family: "Segoe UI", system-ui, -apple-system, sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 16px; }

header { text-align: center; margin-bottom: 16px; }

.badge { display: inline-block; background: rgba(0, 243, 255, 0.1); color: var(--neon-blue); border: 1px solid rgba(0, 243, 255, 0.3); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; padding: 4px 12px; border-radius: 99px; margin-bottom: 6px; }

h1 { font-size: 28px; font-weight: 900; letter-spacing: 0.5px; background: linear-gradient(90deg, rgb(0, 243, 255), rgb(0, 255, 102), rgb(255, 0, 127)) text; -webkit-text-fill-color: transparent; }

.controls-bar { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-top: 8px; font-size: 13px; color: rgb(148, 163, 184); }

.control-pill { background: rgb(30, 41, 59); border: 1px solid rgb(51, 65, 85); padding: 4px 12px; border-radius: 6px; display: flex; align-items: center; gap: 6px; }

.control-pill b { color: rgb(248, 250, 252); }

.main-layout { display: flex; gap: 20px; align-items: stretch; justify-content: center; flex-wrap: wrap; max-width: 1140px; width: 100%; }

.game-wrapper { position: relative; width: 720px; height: 380px; background: var(--panel-bg); border: 2px solid rgb(51, 65, 85); border-radius: 16px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.6) 0px 20px 40px, rgba(0, 243, 255, 0.08) 0px 0px 25px; }

#gameCanvas { width: 100%; height: 100%; display: block; }

.hud { position: absolute; top: 14px; left: 18px; right: 18px; display: flex; justify-content: space-between; align-items: center; pointer-events: none; z-index: 5; }

.hud-stats { display: flex; gap: 16px; background: rgba(15, 23, 42, 0.85); border: 1px solid rgb(51, 65, 85); padding: 6px 14px; border-radius: 8px; font-weight: 700; font-size: 14px; backdrop-filter: blur(4px); }

.stat-val { color: var(--neon-blue); font-family: monospace; font-size: 16px; }

.best-val { color: var(--neon-amber); font-family: monospace; font-size: 16px; }

.gesture-indicators { display: flex; gap: 10px; }

.ind-badge { background: rgba(15, 23, 42, 0.85); border: 1px solid rgb(51, 65, 85); padding: 5px 12px; border-radius: 8px; font-size: 12px; font-weight: 700; color: rgb(100, 116, 139); transition: 0.1s; }

.ind-badge.active-jump { background: rgba(0, 255, 102, 0.2); border-color: var(--neon-green); color: var(--neon-green); box-shadow: rgba(0, 255, 102, 0.4) 0px 0px 12px; }

.ind-badge.active-shoot { background: rgba(255, 0, 127, 0.2); border-color: var(--neon-pink); color: var(--neon-pink); box-shadow: rgba(255, 0, 127, 0.4) 0px 0px 12px; }

#overlay { position: absolute; inset: 0px; background: rgba(9, 13, 22, 0.9); backdrop-filter: blur(6px); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 10; padding: 24px; text-align: center; }

#overlay h2 { font-size: 32px; margin-bottom: 8px; color: rgb(255, 255, 255); }

#overlay p { color: rgb(148, 163, 184); font-size: 14px; max-width: 440px; line-height: 1.5; margin-bottom: 20px; }

.legend-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 24px; width: 100%; max-width: 520px; }

.legend-card { background: rgb(30, 41, 59); border: 1px solid rgb(51, 65, 85); padding: 10px; border-radius: 10px; font-size: 12px; }

.legend-card strong { display: block; color: rgb(248, 250, 252); margin-bottom: 4px; font-size: 13px; }

.btn-start { background: linear-gradient(90deg, rgb(0, 243, 255), rgb(0, 255, 102)); color: rgb(9, 13, 22); font-weight: 800; font-size: 16px; padding: 12px 32px; border: none; border-radius: 10px; cursor: pointer; box-shadow: rgba(0, 243, 255, 0.4) 0px 0px 20px; transition: transform 0.15s; }

.btn-start:hover:not(:disabled) { transform: scale(1.05); }

.btn-start:disabled { background: rgb(51, 65, 85); color: rgb(100, 116, 139); box-shadow: none; cursor: not-allowed; }

.cam-wrapper { width: 340px; background: var(--panel-bg); border: 2px solid rgb(51, 65, 85); border-radius: 16px; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: rgba(0, 0, 0, 0.6) 0px 20px 40px; }

.cam-header { font-size: 13px; font-weight: 700; color: rgb(203, 213, 225); margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }

.fps-tag { font-family: monospace; font-size: 11px; color: var(--neon-green); background: rgba(0, 255, 102, 0.1); padding: 2px 6px; border-radius: 4px; }

.cam-box { position: relative; width: 100%; height: 235px; background: rgb(0, 0, 0); border-radius: 10px; overflow: hidden; border: 1px solid rgb(51, 65, 85); }

video, #camCanvas { position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }

.cam-status { margin-top: 10px; background: rgb(15, 23, 42); border: 1px solid rgb(30, 41, 59); padding: 8px 10px; border-radius: 8px; font-family: monospace; font-size: 12px; color: var(--neon-amber); text-align: center; }

.meter-box { margin-top: 8px; display: flex; flex-direction: column; gap: 6px; font-size: 11px; color: rgb(148, 163, 184); }

.meter-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }

.meter-bar-bg { flex: 1 1 0%; height: 6px; background: rgb(30, 41, 59); border-radius: 99px; overflow: hidden; }

.meter-bar-fill { height: 100%; width: 0%; background: var(--neon-pink); transition: width 0.05s linear; }
